# CCU3-Verbindung
CCU_HOST=192.168.1.10
CCU_USERNAME=admin
CCU_PASSWORD=changeme

# Nur nötig, wenn das Dashboard NICHT same-origin über den nginx-Proxy läuft
# (z. B. lokaler Dev-Server). Kommagetrennte Liste erlaubter Origins.
# CORS_ALLOW_ORIGINS=http://localhost:3000

# Taupunktüberwachung: Vorlauftemperatur über MQTT (optional; ohne MQTT_HOST aus).
# Am besten ein eigener MQTT-Benutzer, der dieses Thema nur lesen darf.
# MQTT_HOST=192.168.1.20
# MQTT_PORT=1883
# MQTT_USERNAME=ccu-dashboard
# MQTT_PASSWORD='...'
# MQTT_FLOW_TOPIC=heizung/vorlauf/temperatur
# Grenzen (Abstand Vorlauf - Taupunkt in K) und Wartezeit nach Ventilöffnung:
# DEW_WARN_MARGIN=3
# DEW_ALARM_MARGIN=1
# FLOW_SETTLE_MINUTES=10
# FLOW_STALE_MINUTES=120
# Home Assistant: Zustand der App per MQTT-Discovery veröffentlichen (Standard an,
# sobald MQTT eingerichtet ist). Der MQTT-Benutzer braucht dafür Schreibrechte, siehe
# docs/03-konfiguration.md, Abschnitt 3.7.
# HA_DISCOVERY=1
# HA_DISCOVERY_PREFIX=homeassistant
# MQTT_BASE_TOPIC=ccu-dashboard
